# ==========================================
# TindahanKo Backend Environment Configuration
# ==========================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit your real .env file to version control.

# Server Port
PORT=8080

# Supabase PostgreSQL Database Connection
# Obtain these from your Supabase Dashboard: Project Settings > Database > Connection Parameters
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# JWT Authentication Secret & Expiration
# Use a secure random string of at least 256 bits (32+ characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_123456
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Semaphore SMS API (Feature 5: Automated SMS Notification System)
# Obtain your API key from https://semaphore.co/
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Free Email Sending Option 1: Google Gmail SMTP (500 free emails/day)
# Generate a free 16-character App Password at: myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=akosirabanal@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_16_char_app_password

# Free Email Sending Option 2: Resend REST API (3,000 free emails/month at resend.com)
RESEND_API_KEY=your_resend_api_key_here
